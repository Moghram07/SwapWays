{
  "name": "swapways",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack",
    "dev:turbopack": "next dev",
    "build": "npx prisma generate && next build",
    "start": "next start",
    "start:build": "npm run build && next start",
    "lint": "eslint --max-warnings 0",
    "test": "vitest run",
    "test:schedule": "cross-env NODE_OPTIONS=--max-old-space-size=8192 vitest run __tests__/schedule",
    "ci:gate": "npm run lint && npm run test && npm run build",
    "db:generate": "npx prisma generate",
    "db:push": "npx prisma db push",
    "db:migrate": "npx prisma migrate dev",
    "db:migrate:deploy": "npx prisma migrate deploy",
    "db:migrate:status": "npx prisma migrate status",
    "db:seed": "npx tsx prisma/seed.ts",
    "db:backfill:tiers": "npx tsx scripts/backfill-tiers.ts",
    "db:studio": "prisma studio",
    "db:cleanup:saudia-fleet": "node scripts/cleanup-saudia-aircraft-fleet.mjs",
    "load:smoke": "k6 run scripts/load/k6-smoke.js",
    "load:staged": "k6 run scripts/load/k6-staged.js",
    "favicon": "node scripts/generate-favicon.mjs",
    "launch:check": "node scripts/launch-readiness.mjs",
    "launch:gate": "npm run launch:check && npm run ci:gate",
    "perf:measure": "node scripts/perf-measure.mjs",
    "analyze": "cross-env ANALYZE=true next build --webpack"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.7.4",
    "@prisma/adapter-pg": "^7.5.0",
    "@prisma/client": "^7.5.0",
    "bcryptjs": "^2.4.3",
    "framer-motion": "^12.35.0",
    "lucide-react": "^0.577.0",
    "next": "16.1.6",
    "next-auth": "^4.24.10",
    "pdf-parse": "^1.1.4",
    "pg": "^8.20.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "swr": "^2.4.1",
    "zustand": "^5.0.2"
  },
  "prisma": {
    "seed": "npx tsx prisma/seed.ts"
  },
  "devDependencies": {
    "@next/bundle-analyzer": "^16.0.0",
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/pg": "^8.18.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "cross-env": "^7.0.3",
    "dotenv": "^16.4.5",
    "eslint": "^9.39.3",
    "eslint-config-next": "16.1.6",
    "png-to-ico": "^3.0.1",
    "prisma": "^7.5.0",
    "sharp": "^0.34.5",
    "tailwindcss": "^4",
    "tsx": "^4.19.2",
    "typescript": "^5",
    "vitest": "^4.1.1"
  }
}
