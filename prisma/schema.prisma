// Swap Ways - Database Schema
// https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
  engineType = "binary"
}

datasource db {
  provider = "postgresql"
}

// ============================================
// AIRLINE CONFIGURATION (Multi-airline ready)
// ============================================

model Airline {
  id            String   @id @default(cuid())
  name          String   @unique
  code          String   @unique
  emailDomain   String   @unique
  createdAt     DateTime @default(now())

  ranks         Rank[]
  aircraftTypes AircraftType[]
  bases         Base[]
  swapRules     SwapRule[]
  users         User[]
}

model Rank {
  id          String       @id @default(cuid())
  name        String
  code        String
  category    CrewCategory
  sortOrder   Int
  airlineId   String
  airline     Airline     @relation(fields: [airlineId], references: [id])
  users       User[]

  @@unique([airlineId, code])
}

model AircraftType {
  id           String    @id @default(cuid())
  name         String
  code         String
  scheduleCode String?
  airlineId    String
  airline      Airline   @relation(fields: [airlineId], references: [id])
  qualifiedUsers UserQualification[]

  @@unique([airlineId, code])
}

model Base {
  id          String   @id @default(cuid())
  name        String
  airportCode String
  airlineId   String
  airline     Airline  @relation(fields: [airlineId], references: [id])
  users       User[]

  @@unique([airlineId, airportCode])
}

model SwapRule {
  id          String       @id @default(cuid())
  ruleType    SwapRuleType
  description String
  isActive    Boolean      @default(true)
  airlineId   String
  airline     Airline     @relation(fields: [airlineId], references: [id])
}

// ============================================
// USER / CREW MEMBER
// ============================================

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  emailVerified DateTime?
  passwordHash  String
  firstName     String
  lastName      String
  crewId        String
  airlineId     String
  airline       Airline  @relation(fields: [airlineId], references: [id])
  rankId        String
  rank          Rank     @relation(fields: [rankId], references: [id])
  baseId        String
  base          Base     @relation(fields: [baseId], references: [id])
  phone         String?
  avatarUrl     String?
  hasUsVisa     Boolean  @default(false)
  hasChinaVisa  Boolean  @default(false)
  tier          UserTier @default(PREMIUM)
  trialStartedAt DateTime @default(now())
  trialEndsAt    DateTime @default(now())
  trialExtended  Boolean  @default(false)
  isVerified     Boolean  @default(false)
  verifiedAt     DateTime?
  referredBy     String?
  referralBonusCount Int  @default(0)
  subscriptionStatus SubscriptionStatus @default(TRIALING)
  subscribedAt   DateTime?
  subscriptionRenewsAt DateTime?
  cancelledAt    DateTime?
  isActive      Boolean  @default(true)
  isAdmin       Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  qualifications UserQualification[]
  trades         Trade[]
  swapPosts      SwapPost[]
  lineSwapPosts  LineSwapPost[]
  matchesOffered Match[]  @relation("matchOfferer")
  matchesReceived Match[]  @relation("matchReceiver")
  schedules      Schedule[]
  notifications  Notification[]
  conversationsInitiated Conversation[] @relation("conversationInitiator")
  conversationsReceived  Conversation[] @relation("conversationTradeOwner")
  conversationsAsPostOwner Conversation[] @relation("conversationPostOwner")
  messages               Message[]
  feedbackItems          Feedback[]
  assignedFeedback       Feedback[] @relation("feedbackAssignee")
  appEvents              AppEvent[]
  emailVerificationCodes EmailVerificationCode[]
  passwordResetTokens    PasswordResetToken[]
  trialRewards           TrialReward[]
  adminActionsPerformed  AdminAction[] @relation("adminActionActor")
  adminActionsTargeted   AdminAction[] @relation("adminActionTarget")
  sessions               UserSession[]
  flags                  AccountFlag[]
  feedbackMessages       FeedbackMessage[] @relation("feedbackSender")
  referralsMade          Referral[] @relation("referrer")
  referralsReceived      Referral[] @relation("referred")
  referralCode           String?    @unique

  @@unique([airlineId, crewId])
  @@index([subscriptionStatus, trialEndsAt])
  @@index([baseId])
  @@index([rankId])
}

model EmailVerificationCode {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  codeHash    String
  expiresAt   DateTime
  attempts    Int      @default(0)
  resendCount Int      @default(0)
  lastSentAt  DateTime @default(now())
  consumedAt  DateTime?
  createdAt   DateTime @default(now())

  @@index([userId, createdAt])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  /** Set when Resend accepted the message; used for send cooldown only after real delivery. */
  sentAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, createdAt])
}

model TrialReward {
  id          String          @id @default(cuid())
  userId      String
  user        User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  type        TrialRewardType
  daysGranted Int
  metadata    Json?
  createdAt   DateTime        @default(now())

  @@unique([userId, type])
  @@index([userId, createdAt])
}

model AdminAction {
  id           String   @id @default(cuid())
  adminUserId  String
  adminUser    User     @relation("adminActionActor", fields: [adminUserId], references: [id], onDelete: Cascade)
  adminEmail   String
  action       String
  targetUserId String?
  targetUser   User?    @relation("adminActionTarget", fields: [targetUserId], references: [id], onDelete: SetNull)
  reason       String?
  details      String?
  createdAt    DateTime @default(now())

  @@index([adminUserId, createdAt])
  @@index([targetUserId, createdAt])
  @@index([action, createdAt])
}

model UserSession {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  ipAddress    String
  userAgent    String
  city         String?
  country      String?
  lastActiveAt DateTime @default(now())
  createdAt    DateTime @default(now())

  @@unique([userId, ipAddress])
  @@index([userId])
  @@index([lastActiveAt])
}

model AccountFlag {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type       FlagType
  details    String
  isResolved Boolean  @default(false)
  resolvedBy String?
  resolvedAt DateTime?
  adminNotes String?
  createdAt  DateTime @default(now())

  @@index([userId])
  @@index([isResolved])
  @@index([createdAt])
}

model Referral {
  id             String         @id @default(cuid())
  referrerUserId String
  referrer       User           @relation("referrer", fields: [referrerUserId], references: [id], onDelete: Cascade)
  referredUserId String
  referred       User           @relation("referred", fields: [referredUserId], references: [id], onDelete: Cascade)
  bonusDays      Int            @default(10)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@unique([referredUserId])
  @@index([referrerUserId, createdAt])
}

model UserQualification {
  id             String       @id @default(cuid())
  userId         String
  user           User         @relation(fields: [userId], references: [id])
  aircraftTypeId String
  aircraftType   AircraftType @relation(fields: [aircraftTypeId], references: [id])

  @@unique([userId, aircraftTypeId])
}

// ============================================
// TRADES
// ============================================

model Trade {
  id               String        @id @default(cuid())
  userId           String
  user             User          @relation(fields: [userId], references: [id])
  scheduleTripId   String?       @unique
  scheduleTrip     ScheduleTrip? @relation(fields: [scheduleTripId], references: [id])
  tradeType        TradeType
  status           TradeStatus @default(OPEN)
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt
  expiresAt        DateTime?

  tripNumber       String?
  flightNumber     String?
  aircraftTypeCode String?
  destination      String?
  departureDate    DateTime?
  reportTime       String?
  departureTime    String?
  arrivalTime      String?
  flyingTime       Float?
  layoverDuration  Float?
  creditHours      Float?
  blockHours       Float?
  tafb             Float?

  desiredDestinations String[]
  wtfDays             Int[]
  preferMinCredit     Float?
  preferMaxCredit     Float?
  notes               String?

  vacationStartDate   DateTime?
  vacationEndDate     DateTime?
  desiredVacationStart DateTime?
  desiredVacationEnd   DateTime?

  matches Match[]
  conversations Conversation[]

  @@index([userId, status, createdAt])
  @@index([tradeType, status, departureDate])
  @@index([status, departureDate])
  @@index([userId, tradeType, status])
}

// ============================================
// SWAP POSTS (Marketplace)
// ============================================

model SwapPost {
  id               String         @id @default(cuid())
  userId           String
  user             User           @relation(fields: [userId], references: [id])
  postType         SwapPostType
  status           SwapPostStatus @default(OPEN)
  offeringDaysOff  Boolean        @default(false)
  offeredDaysOff   Int[]
  wantType         WantType
  wantTripTypes    TripType[]
  wantMinLayover   Float?
  wantMinCredit    Float?
  wantMaxCredit    Float?
  wantEqualHours   Boolean        @default(false)
  wantSameDate     Boolean        @default(false)
  wantDestinations String[]
  wantExclude      String[]
  /** OR-style acceptance rules: each item is one acceptable alternative (display + future matching). */
  wantAcceptanceOptions Json?
  wtfDays          Int[]
  wantDaysOff      Boolean        @default(false)
  notes            String?
  vacationStartDate    DateTime?
  vacationEndDate      DateTime?
  desiredVacationStart DateTime?
  desiredVacationEnd   DateTime?
  vacationYear         Int?
  vacationMonth        Int?
  vacationStartDay     Int?
  vacationEndDay       Int?
  desiredVacationMonths Int[]      @default([])
  inputSource       String?
  quickTripType     TripType?
  quickDestinations String[]       @default([])
  quickDate         DateTime?
  quickLayoverHours Float?
  advancedReportTime       String?
  advancedAircraftTypeCode String?
  advancedBlockHours       Float?
  advancedFlightNumber     String?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  expiresAt        DateTime?

  offeredTrips   SwapPostTrip[]
  conversations  Conversation[]

  @@index([userId])
  @@index([status])
  @@index([postType])
  @@index([status, createdAt])
  @@index([userId, createdAt])
}

model SwapPostTrip {
  id             String       @id @default(cuid())
  swapPostId     String
  swapPost       SwapPost     @relation(fields: [swapPostId], references: [id], onDelete: Cascade)
  scheduleTripId String?
  scheduleTrip   ScheduleTrip? @relation(fields: [scheduleTripId], references: [id])
  flightNumber   String?
  destination    String
  destinations   String[]      @default([])
  departureDate  DateTime
  tripType       TripType
  creditHours    Float?
  tafb           Float?
  reportTime     String?
  aircraftType   String?
  blockHours     Float?
  hasLayover     Boolean
  layoverCity    String?
  layoverHours   Float?
  legLayovers    Json?
  isManualEntry  Boolean       @default(false)

  @@index([swapPostId])
  @@index([scheduleTripId])
}

// ============================================
// MATCHES
// ============================================

model Match {
  id             String     @id @default(cuid())
  tradeId        String
  trade          Trade      @relation(fields: [tradeId], references: [id])
  offererId      String
  offerer        User       @relation("matchOfferer", fields: [offererId], references: [id])
  receiverId     String
  receiver       User       @relation("matchReceiver", fields: [receiverId], references: [id])
  matchScore     Float
  status         MatchStatus @default(PENDING)
  rejectionReason String?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  confirmedAt    DateTime?
}

model MatchCache {
  id           String   @id @default(cuid())
  postId        String
  viewerId      String
  matchPercent  Int
  reasons       String[]
  calculatedAt  DateTime @default(now())

  @@unique([postId, viewerId])
  @@index([viewerId])
  @@index([viewerId, matchPercent])
  @@index([postId])
}

// ============================================
// SCHEDULE (Phase 2)
// ============================================

model Schedule {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id])
  lineNumber   String
  month        Int
  year         Int
  totalCredit  Float?
  totalBlock   Float?
  daysOff      Int?
  dutyPeriods  Int?
  rawText      String?
  isConfirmed  Boolean  @default(false)
  createdAt    DateTime @default(now())

  trips ScheduleTrip[]
  lineSwapPosts LineSwapPost[]

  @@unique([userId, month, year])
}

model ScheduleTrip {
  id           String     @id @default(cuid())
  scheduleId   String
  schedule     Schedule   @relation(fields: [scheduleId], references: [id])
  tripNumber   String
  instanceId   String
  reportTime   String
  startDate    DateTime
  endDate      DateTime
  tripType     TripType
  creditHours  Float
  blockHours   Float
  tafb         Float
  routeType    RouteType

  legs               ScheduleTripLeg[]
  layovers           ScheduleTripLayover[]
  trade              Trade?
  offeredInConversations Conversation[]
  swapPostTrips      SwapPostTrip[]
  conversationOffers ConversationOffer[]

  @@unique([scheduleId, instanceId])
}

model ScheduleTripLayover {
  id              String       @id @default(cuid())
  scheduleTripId  String
  scheduleTrip    ScheduleTrip @relation(fields: [scheduleTripId], references: [id])
  airport         String
  durationRaw     String
  durationDecimal Float
  afterLegOrder   Int
}

model ScheduleTripLeg {
  id               String       @id @default(cuid())
  scheduleTripId   String
  scheduleTrip     ScheduleTrip @relation(fields: [scheduleTripId], references: [id])
  legOrder         Int
  dayOfWeek        String?
  flightNumber     String
  aircraftTypeCode String
  departureDate    DateTime
  departureTime    String
  departureAirport String
  arrivalDate      DateTime
  arrivalTime      String
  arrivalAirport   String
  flyingTimeRaw    String?
  flyingTime       Float
  layoverDuration  Float?
  layoverAirport   String?
}

// ============================================
// CHAT / CONVERSATIONS
// ============================================

model Conversation {
  id              String             @id @default(cuid())
  tradeId         String?
  trade           Trade?             @relation(fields: [tradeId], references: [id])
  initiatorId     String
  initiator       User               @relation("conversationInitiator", fields: [initiatorId], references: [id])
  tradeOwnerId    String?
  tradeOwner      User?              @relation("conversationTradeOwner", fields: [tradeOwnerId], references: [id])
  offeredTripId   String?
  offeredTrip     ScheduleTrip?      @relation(fields: [offeredTripId], references: [id])
  swapPostId      String?
  swapPost        SwapPost?          @relation(fields: [swapPostId], references: [id])
  lineSwapPostId  String?
  lineSwapPost    LineSwapPost?      @relation(fields: [lineSwapPostId], references: [id])
  postOwnerId     String?
  postOwner       User?              @relation("conversationPostOwner", fields: [postOwnerId], references: [id])
  status          ConversationStatus @default(ACTIVE)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  lastMessageAt   DateTime          @default(now())
  messages        Message[]
  offeredTrips    ConversationOffer[]

  @@unique([tradeId, initiatorId])
  @@unique([swapPostId, initiatorId])
  @@unique([lineSwapPostId, initiatorId])
  @@index([lastMessageAt])
  @@index([initiatorId, lastMessageAt])
  @@index([tradeOwnerId, lastMessageAt])
  @@index([postOwnerId, lastMessageAt])
}

model LineSwapPost {
  id               String         @id @default(cuid())
  userId           String
  user             User           @relation(fields: [userId], references: [id])

  lineNumber       String
  lineType         LineType       @default(NORMAL)
  month            String
  year             Int

  totalBlock       Float?
  daysOffStart     Int
  daysOffEnd       Int
  hasReserve       Boolean        @default(false)
  reserveDays      Int[]          @default([])

  wantDaysOffStart Int?
  wantDaysOffEnd   Int?
  wantDestination  String?
  wantLineType     LineType?
  wantNoReserve    Boolean        @default(false)
  notes            String?

  scheduleId       String?
  schedule         Schedule?      @relation(fields: [scheduleId], references: [id])

  status           SwapPostStatus @default(OPEN)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  layovers         LineSwapLayover[]
  conversations    Conversation[]

  @@index([userId])
  @@index([status, createdAt])
}

model LineSwapLayover {
  id             String       @id @default(cuid())
  lineSwapPostId String
  lineSwapPost   LineSwapPost @relation(fields: [lineSwapPostId], references: [id], onDelete: Cascade)
  destination    String
  durationHours  Float
  durationRaw    String

  @@index([lineSwapPostId])
}

model ConversationOffer {
  id              String       @id @default(cuid())
  conversationId  String
  conversation    Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  scheduleTripId  String
  scheduleTrip    ScheduleTrip @relation(fields: [scheduleTripId], references: [id])

  @@unique([conversationId, scheduleTripId])
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id])
  senderId       String
  sender         User         @relation(fields: [senderId], references: [id])
  content        String
  messageType    MessageType  @default(TEXT)
  systemAction   SystemAction?
  isRead         Boolean      @default(false)
  createdAt      DateTime     @default(now())

  @@index([conversationId, createdAt])
}

// ============================================
// NOTIFICATIONS
// ============================================

model Notification {
  id        String           @id @default(cuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id])
  type      NotificationType
  title     String
  message   String
  isRead    Boolean          @default(false)
  data      Json?
  createdAt DateTime         @default(now())

  @@index([userId, isRead, createdAt])
}

model Feedback {
  id         String           @id @default(cuid())
  userId     String
  user       User             @relation(fields: [userId], references: [id])
  type       FeedbackType
  status     FeedbackStatus   @default(OPEN)
  priority   FeedbackPriority @default(NORMAL)
  subject    String?
  message    String
  adminNote  String?
  assigneeId String?
  assignee   User?            @relation("feedbackAssignee", fields: [assigneeId], references: [id])
  messages   FeedbackMessage[]
  hasUnreadByUser  Boolean    @default(false)
  hasUnreadByAdmin Boolean    @default(false)
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt
  resolvedAt DateTime?

  @@index([userId, createdAt])
  @@index([status, createdAt])
  @@index([type, createdAt])
  @@index([assigneeId, status])
}

model FeedbackMessage {
  id         String   @id @default(cuid())
  feedbackId String
  feedback   Feedback @relation(fields: [feedbackId], references: [id], onDelete: Cascade)
  senderId   String
  sender     User     @relation("feedbackSender", fields: [senderId], references: [id])
  isAdmin    Boolean  @default(false)
  message    String
  createdAt  DateTime @default(now())

  @@index([feedbackId])
  @@index([createdAt])
}

model AppEvent {
  id          String   @id @default(cuid())
  userId      String?
  user        User?    @relation(fields: [userId], references: [id])
  anonymousId String?
  eventName   String
  path        String?
  properties  Json?
  createdAt   DateTime @default(now())

  @@index([eventName, createdAt])
  @@index([userId, createdAt])
  @@index([path, createdAt])
}

// ============================================
// ENUMS
// ============================================

enum CrewCategory {
  CABIN
  FLIGHT_DECK
}

enum TradeType {
  FLIGHT_SWAP
  VACATION_SWAP
}

enum TradeStatus {
  OPEN
  MATCHED
  ACCEPTED
  COMPLETED
  EXPIRED
  CANCELLED
}

enum TripType {
  LAYOVER
  TURNAROUND
  MULTI_STOP
  PAIRING_WITH_LAYOVER
}

enum SwapPostType {
  OFFERING_TRIPS
  OFFERING_DAYS_OFF
  GIVING_AWAY
  LOOKING_FOR
  VACATION_SWAP
}

enum SwapPostStatus {
  OPEN
  IN_NEGOTIATION
  AGREED
  COMPLETED
  EXPIRED
  CANCELLED
}

enum WantType {
  LAYOVER
  LONGER_LAYOVER
  ROUND_TRIP
  ANY_FLIGHT
  DAYS_OFF
  ANYTHING
  SPECIFIC
}

enum RouteType {
  DOMESTIC
  INTERNATIONAL
}

enum LineType {
  NORMAL
  US_LINE
  CHINA_LINE
  RESERVE_LINE
  KULN
  INDO
  HJLN
  TRNG
}

enum MatchStatus {
  PENDING
  ACCEPTED
  REJECTED
  EXPIRED
}

enum UserTier {
  FREE
  PREMIUM
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELLED
  EXPIRED
}

enum NotificationType {
  MATCH_FOUND
  MATCH_ACCEPTED
  MATCH_REJECTED
  TRADE_EXPIRED
  NEW_MESSAGE
  SWAP_PROPOSED
  SWAP_ACCEPTED
  ACCOUNT_WARNING
  FEEDBACK_REPLY
  SYSTEM
}

enum FlagType {
  CONCURRENT_SESSIONS
  LOCATION_JUMP
  SUSPICIOUS_POSTING
  MANUAL
}

enum ConversationStatus {
  ACTIVE
  SWAP_PROPOSED
  SWAP_ACCEPTED
  DECLINED
  EXPIRED
}

enum MessageType {
  TEXT
  SYSTEM
  TRIP_OFFER
}

enum SystemAction {
  SWAP_PROPOSED
  SWAP_ACCEPTED
  SWAP_DECLINED
  TRIP_OFFERED
  TRIP_CHANGED
  CONVERSATION_CLOSED
}

enum SwapRuleType {
  OVERTIME_LIMIT
  NO_PARTIAL_TRADE
  DOMESTIC_RESTRICTION
  QUALIFICATION_MISMATCH
  BASE_MISMATCH
  RANK_MISMATCH
  REST_VIOLATION
  SCHEDULE_CONFLICT
}

enum FeedbackType {
  REQUEST
  QUESTION
  SUGGESTION
}

enum FeedbackStatus {
  OPEN
  IN_PROGRESS
  CLOSED
}

enum FeedbackPriority {
  LOW
  NORMAL
  HIGH
}

enum TrialRewardType {
  SCHEDULE_UPLOAD
  INSTALL_APP
  REFERRAL
}

// Email verification (NextAuth / custom)
model VerificationToken {
  id         String   @id @default(cuid())
  identifier String
  token      String   @unique
  expires    DateTime
  createdAt  DateTime @default(now())
}
